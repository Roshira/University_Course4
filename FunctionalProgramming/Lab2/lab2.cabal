cabal-version:      2.4
name:               lab2
version:            1.0.0
synopsis:           Сортування Бетчера (odd-even merge sort) на k потоках
build-type:         Simple

common shared
  default-language: Haskell2010
  ghc-options:      -Wall -Wno-name-shadowing -O2
  build-depends:
      base  >=4.14 && <5
    , array

library
  import:          shared
  hs-source-dirs:  src
  exposed-modules: Batcher
                   Console

executable lab2
  import:          shared
  hs-source-dirs:  app
  main-is:         Main.hs
  build-depends:   lab2
  ghc-options:     -threaded -rtsopts "-with-rtsopts=-N"

test-suite lab2-test
  import:          shared
  type:            exitcode-stdio-1.0
  hs-source-dirs:  test
  main-is:         Spec.hs
  build-depends:   lab2
  ghc-options:     -threaded -rtsopts "-with-rtsopts=-N"
