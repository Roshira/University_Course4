cabal-version:      2.4
name:               lab1
version:            1.0.0
synopsis:           ІС "Індивідуальна робота кафедри зі студентами" (Haskell + MySQL)
build-type:         Simple

common shared
  default-language: Haskell2010
  ghc-options:      -Wall -Wno-name-shadowing
  build-depends:
      base        >=4.14 && <5
    , text
    , bytestring
    , containers
    , time
    , mysql-haskell
    , io-streams
    , scotty
    , lucid
    , http-types

library
  import:          shared
  hs-source-dirs:  src
  exposed-modules:
      Model.Field
      Model.Entity
      Model.Entities
      Model.Report
      Db
      Web.View
      Web.Server

executable lab1
  import:          shared
  hs-source-dirs:  app
  main-is:         Main.hs
  build-depends:   lab1
  ghc-options:     -threaded -rtsopts
