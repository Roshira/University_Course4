cabal-version:      2.4
name:               lab3
version:            1.0.0
synopsis:           Обробка тексту підручника (варіант 6)
build-type:         Simple
data-files:         data/textbook.txt

common shared
  default-language: Haskell2010
  ghc-options:      -Wall -Wno-name-shadowing
  build-depends:    base >=4.14 && <5

library
  import:          shared
  hs-source-dirs:  src
  exposed-modules: Text.Types
                   Text.Parser
                   Text.Task

executable lab3
  import:          shared
  hs-source-dirs:  app
  main-is:         Main.hs
  build-depends:   lab3

test-suite lab3-test
  import:          shared
  type:            exitcode-stdio-1.0
  hs-source-dirs:  test
  main-is:         Spec.hs
  build-depends:   lab3
