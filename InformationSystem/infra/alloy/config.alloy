// Grafana Alloy: збирає stdout усіх контейнерів цього compose-проєкту і відправляє в Loki.

discovery.docker "containers" {
  host = "unix:///var/run/docker.sock"
  filter {
    name   = "label"
    values = ["com.docker.compose.project=analytics-monitoring"]
  }
}

discovery.relabel "containers" {
  targets = []

  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/(.*)"
    target_label  = "container"
  }
  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
    target_label  = "service"
  }
}

loki.source.docker "containers" {
  host          = "unix:///var/run/docker.sock"
  targets       = discovery.docker.containers.targets
  relabel_rules = discovery.relabel.containers.rules
  forward_to    = [loki.process.parse.receiver]
}

loki.process "parse" {
  // Рівень логу береться з трьох форматів:
  //   JSON  — Python-сервіси {"level": "info"}, ASP.NET Core {"LogLevel": "Information"};
  //   logfmt — Grafana, Loki, Tempo, Alloy, Prometheus: level=warn;
  //   PostgreSQL — "... ERROR:  ..." / "WARNING:" / "FATAL:".
  stage.json {
    expressions = { json_level = "level || LogLevel" }
  }
  // logfmt (level=warn) розбираємо регулярним виразом: stage.logfmt писав би помилку на кожен JSON-рядок
  stage.regex {
    expression = `(?:^|\s)level=(?P<lf_level>[A-Za-z]+)`
  }
  stage.regex {
    expression = `\s(?P<pg_level>ERROR|FATAL|PANIC|WARNING):\s`
  }
  // зводимо до єдиного набору значень: error / warning / info / debug
  stage.template {
    source   = "level"
    template = "{{ $l := ToLower (or .json_level .lf_level .pg_level \"info\") }}{{ if or (eq $l \"information\") (eq $l \"notice\") (eq $l \"log\") }}info{{ else if eq $l \"warn\" }}warning{{ else if or (eq $l \"fatal\") (eq $l \"panic\") (eq $l \"critical\") (eq $l \"crit\") (eq $l \"eror\") }}error{{ else if or (eq $l \"trace\") (eq $l \"dbug\") }}debug{{ else }}{{ $l }}{{ end }}"
  }
  stage.labels {
    values = { level = "" }
  }
  forward_to = [loki.write.default.receiver]
}

loki.write "default" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}
