{
  "uid": "db-logs-traces",
  "title": "Логи (Loki) і трейси (Tempo)",
  "description": "Логи всіх контейнерів і розподілені трейси запиту від генератора до PostgreSQL",
  "editable": true,
  "schemaVersion": 39,
  "tags": [
    "db-monitoring"
  ],
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "refresh": "10s",
  "timezone": "browser",
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Логи",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Кількість рядків логу за рівнем",
      "description": "",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum by (level) (count_over_time({service=~\"$service\", level=~\"$level\"} |= \"$search\" [1m]))",
          "legendFormat": "{{level}}",
          "queryType": "range",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 50,
            "showPoints": "never",
            "stacking": {
              "mode": "normal"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "id": 2,
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 12,
        "h": 7
      }
    },
    {
      "type": "timeseries",
      "title": "Помилки за сервісами",
      "description": "",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum by (service) (count_over_time({service=~\"$service\", level=~\"error|critical|fatal\"}[1m]))",
          "legendFormat": "{{service}}",
          "queryType": "range",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 50,
            "showPoints": "never",
            "stacking": {
              "mode": "normal"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "id": 3,
      "gridPos": {
        "x": 12,
        "y": 1,
        "w": 12,
        "h": 7
      }
    },
    {
      "type": "logs",
      "title": "Логи (клацніть рядок -> TraceID -> перехід у Tempo)",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "{service=~\"$service\", level=~\"$level\"} |= \"$search\"",
          "queryType": "range"
        }
      ],
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "prettifyLogMessage": false,
        "enableLogDetails": true,
        "sortOrder": "Descending",
        "dedupStrategy": "none",
        "showLabels": false,
        "showCommonLabels": false
      },
      "id": 4,
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 24,
        "h": 12
      }
    },
    {
      "id": 5,
      "type": "row",
      "title": "Трейси",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 20,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "type": "nodeGraph",
      "title": "Граф сервісів (з трейсів)",
      "datasource": {
        "type": "tempo",
        "uid": "tempo"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "tempo",
            "uid": "tempo"
          },
          "queryType": "serviceMap"
        }
      ],
      "id": 6,
      "gridPos": {
        "x": 0,
        "y": 21,
        "w": 12,
        "h": 10
      }
    },
    {
      "type": "timeseries",
      "title": "RED за span-metrics: запити/с по сервісах",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (service) (rate(traces_spanmetrics_calls_total{span_kind=~\"SPAN_KIND_SERVER|SPAN_KIND_CONSUMER\"}[1m]))",
          "legendFormat": "{{service}}",
          "range": true,
          "instant": false,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 0,
            "showPoints": "never",
            "stacking": {
              "mode": "none"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "id": 7,
      "gridPos": {
        "x": 12,
        "y": 21,
        "w": 12,
        "h": 5
      }
    },
    {
      "type": "timeseries",
      "title": "p95 тривалість спанів по сервісах",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le, service) (rate(traces_spanmetrics_latency_bucket{span_kind=~\"SPAN_KIND_SERVER|SPAN_KIND_CONSUMER\"}[1m])))",
          "legendFormat": "{{service}}",
          "range": true,
          "instant": false,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 0,
            "showPoints": "never",
            "stacking": {
              "mode": "none"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "id": 8,
      "gridPos": {
        "x": 12,
        "y": 26,
        "w": 12,
        "h": 5
      }
    },
    {
      "type": "table",
      "title": "Останні трейси (TraceQL: повний шлях події в БД)",
      "datasource": {
        "type": "tempo",
        "uid": "tempo"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "tempo",
            "uid": "tempo"
          },
          "queryType": "traceql",
          "limit": 20,
          "tableType": "traces",
          "query": "{ resource.service.name = \"ingest-worker\" && name = \"rabbitmq.consume\" }"
        }
      ],
      "id": 9,
      "gridPos": {
        "x": 0,
        "y": 31,
        "w": 12,
        "h": 10
      }
    },
    {
      "type": "table",
      "title": "Повільні / помилкові трейси (> 200 мс або error)",
      "datasource": {
        "type": "tempo",
        "uid": "tempo"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "tempo",
            "uid": "tempo"
          },
          "queryType": "traceql",
          "limit": 20,
          "tableType": "traces",
          "query": "{ duration > 200ms || status = error }"
        }
      ],
      "id": 10,
      "gridPos": {
        "x": 12,
        "y": 31,
        "w": 12,
        "h": 10
      }
    }
  ],
  "templating": {
    "list": [
      {
        "name": "service",
        "label": "Сервіс",
        "type": "query",
        "datasource": {
          "type": "loki",
          "uid": "loki"
        },
        "query": {
          "label": "service",
          "stream": "",
          "type": 1,
          "refId": "LokiVariableQueryEditor-VariableQuery"
        },
        "definition": "label_values(service)",
        "includeAll": true,
        "multi": true,
        "allValue": ".+",
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "refresh": 2,
        "sort": 1
      },
      {
        "name": "level",
        "label": "Рівень",
        "type": "custom",
        "includeAll": true,
        "multi": true,
        "allValue": ".+",
        "query": "error,warning,warn,info,information,debug",
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        }
      },
      {
        "name": "search",
        "label": "Пошук у тексті",
        "type": "textbox",
        "query": "",
        "current": {
          "value": ""
        }
      }
    ]
  },
  "links": [
    {
      "title": "Дашборди",
      "type": "dashboards",
      "tags": [
        "db-monitoring"
      ],
      "asDropdown": true
    },
    {
      "title": "Користувачі",
      "type": "link",
      "url": "/auth/users",
      "targetBlank": false
    },
    {
      "title": "Вийти",
      "type": "link",
      "url": "/auth/logout"
    }
  ]
}