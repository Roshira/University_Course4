    {
      "type": "timeseries",
      "title": "Події за хвилину (SQL напряму з PostgreSQL)",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "postgres"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "postgres"
          },
          "format": "time_series",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT date_trunc('minute', \"Timestamp\") AS time, \"EventType\" AS metric, count(*) AS value\nFROM \"Events\"\nWHERE $__timeFilter(\"Timestamp\")\nGROUP BY 1, 2\nORDER BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 70,
            "stacking": {
              "mode": "normal"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "id": 9,
      "gridPos": {
        "x": 0,
        "y": 21,
        "w": 12,
        "h": 8
      }
    },
    {
      "type": "table",
      "title": "Останні 50 подій (SQL)",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "postgres"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "postgres"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT \"Timestamp\" AS \"Час\", \"EventType\" AS \"Тип\", \"Url\" AS \"Сторінка\",\n       \"ElementTag\" AS \"Елемент\", left(\"SessionId\", 8) AS \"Сесія\"\nFROM \"Events\" ORDER BY \"Timestamp\" DESC LIMIT 50"
        }
      ],
      "options": {
        "showHeader": true
      },
      "id": 10,
      "gridPos": {
        "x": 12,
        "y": 21,
        "w": 12,
        "h": 8
      }
    },
    {
      "type": "bargauge",
      "title": "Воронка покупки за обраний період (SQL)",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "postgres"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "postgres"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT step AS \"Крок\", (SELECT count(DISTINCT \"SessionId\") FROM \"Events\"\n  WHERE \"ElementTag\" = step AND $__timeFilter(\"Timestamp\")) AS \"Сесій\"\nFROM unnest(ARRAY['Каталог','Додати в кошик','Оформити замовлення','Підтвердити оплату'])\n  WITH ORDINALITY AS s(step, n) ORDER BY n"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "continuous-GrYlRd"
          },
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "displayMode": "gradient",
        "showUnfilled": true,
        "reduceOptions": {
          "calcs": [],
          "values": true,
          "fields": "/^Сесій$/"
        },
        "namePlacement": "left"
      },
      "id": 11,
      "gridPos": {
        "x": 0,
        "y": 29,
        "w": 24,
        "h": 8
      }
    }
