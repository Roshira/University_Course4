# Скопіюйте у .env і змініть паролі перед запуском:  cp .env.example .env
GATEWAY_PORT=8080

# вхід у систему моніторингу (створюється при першому запуску auth-server)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin12345
# ключ підпису сесій; порожнє значення -> auth-server згенерує випадковий і збереже у volume auth-data
AUTH_SECRET=

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
# пароль вбудованого admin Grafana (вхід у Grafana все одно лише через auth-server)
GRAFANA_ADMIN_PASSWORD=change-me-grafana-admin
# пароль користувача БД лише для читання (Grafana, db-monitor, postgres-exporter)
GRAFANA_DB_PASSWORD=grafana_ro_pass

RABBITMQ_USER=telemetry
RABBITMQ_PASSWORD=telemetry

# інтенсивність генератора (сесій відвідувачів на секунду)
GENERATOR_SESSIONS_PER_SEC=3
