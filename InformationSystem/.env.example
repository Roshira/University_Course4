# Скопіюйте у .env і змініть паролі перед запуском:  cp .env.example .env
GATEWAY_PORT=8080

# вхід у систему моніторингу (створюється при першому запуску auth-server)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin12345
AUTH_SECRET=change-me-please-very-long-random-string

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
GRAFANA_DB_PASSWORD=grafana_ro_pass

RABBITMQ_USER=telemetry
RABBITMQ_PASSWORD=telemetry

# інтенсивність генератора (сесій відвідувачів на секунду)
GENERATOR_SESSIONS_PER_SEC=3
